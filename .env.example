# -----------------------------------------------------------------------------
# Copy to .env.local (local dev) or set in your hosting provider.
# NEXT_PUBLIC_* values are sent to the browser. Everything else is server-only.
# -----------------------------------------------------------------------------

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (newer projects) or the legacy anon key. Safe to expose:
# it can only do what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   (legacy alternative to the line above)

# Public URL of this app (used in email links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional product name shown in the UI.
# NEXT_PUBLIC_APP_NAME=MarketingHQ

# SERVER ONLY. Secret key (or legacy service_role key). Needed to send team
# invitations through the Supabase Auth admin API. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Phase 4/5 integrations (not used yet). Server-only.
# -----------------------------------------------------------------------------
# 32-byte key (base64) used to encrypt OAuth tokens before they are stored.
# Generate with: openssl rand -base64 32
# INTEGRATION_ENCRYPTION_KEY=
# META_APP_ID=
# META_APP_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
